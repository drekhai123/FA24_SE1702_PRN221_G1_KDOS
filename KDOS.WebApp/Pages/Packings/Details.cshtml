@page
@model KDOS.WebApp.Pages.Packings.DetailsModel
@{
    ViewData["Title"] = "Packing Details";
}

<h1>Packing Details</h1>

<div>
    <h4>Packing</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Id</dt>
        <dd class="col-sm-10">@Model.Packing.Id</dd>

        <dt class="col-sm-2">OrderId</dt>
        <dd class="col-sm-10">@Model.Packing.OrderId</dd>

        <dt class="col-sm-2">PackerId</dt>
        <dd class="col-sm-10">@Model.Packing.PackerId</dd>

        <dt class="col-sm-2">Packing Date</dt>
        <dd class="col-sm-10">@Model.Packing.PackingDate</dd>

        <dt class="col-sm-2">Oxygen Level</dt>
        <dd class="col-sm-10">@Model.Packing.OxygenLevel</dd>

        <dt class="col-sm-2">Water Temperature</dt>
        <dd class="col-sm-10">@Model.Packing.WaterTemperature</dd>

        <dt class="col-sm-2">Packing Notes</dt>
        <dd class="col-sm-10">@Model.Packing.PackingNotes</dd>

        <dt class="col-sm-2">Status</dt>
        <dd class="col-sm-10">@Model.Packing.Status</dd>
    </dl>
</div>

<a asp-page="./Edit" asp-route-id="@Model.Packing.Id">Edit</a>
<a asp-page="./Index">Back to List</a>

