@page
@model KDOS.WebApp.Pages.Packings.EditModel
@{
    ViewData["Title"] = "Edit Packing";
}

<h1>Edit Packing</h1>

<form method="post">
    <div class="form-group">
        <label asp-for="Packing.Id"></label>
        <input asp-for="Packing.Id" class="form-control" readonly />
        <span asp-validation-for="Packing.Id" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="Packing.OrderId"></label>
        <input asp-for="Packing.OrderId" class="form-control" />
        <span asp-validation-for="Packing.OrderId" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="Packing.PackerId"></label>
        <input asp-for="Packing.PackerId" class="form-control" />
        <span asp-validation-for="Packing.PackerId" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="Packing.PackingDate"></label>
        <input asp-for="Packing.PackingDate" class="form-control" type="date" />
        <span asp-validation-for="Packing.PackingDate" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="Packing.OxygenLevel"></label>
        <input asp-for="Packing.OxygenLevel" class="form-control" />
        <span asp-validation-for="Packing.OxygenLevel" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="Packing.WaterTemperature"></label>
        <input asp-for="Packing.WaterTemperature" class="form-control" />
        <span asp-validation-for="Packing.WaterTemperature" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="Packing.PackingNotes"></label>
        <textarea asp-for="Packing.PackingNotes" class="form-control"></textarea>
        <span asp-validation-for="Packing.PackingNotes" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="Packing.Status"></label>
        <input asp-for="Packing.Status" class="form-control" />
        <span asp-validation-for="Packing.Status" class="text-danger"></span>
    </div>

    <div class="form-group">
        <input type="submit" value="Save" class="btn btn-primary" />
    </div>
</form>

<p>
    <a asp-page="./Index">Back to List</a>
</p>
